# Python and test caches
__pycache__/
*.py[cod]
.pytest_cache/
.coverage*

# Editor/OS/office artifacts
*.swp
*.swo
*~
.DS_Store
.goutputstream-*
.Rhistory
.~lock.*
.ipynb_checkpoints/
*.asv

# Local environments and workspaces
.env
.venv/
env/
venv/
work/
scratch/

# Local BIDS/derivative mirrors
/bids/
/derivatives/*
