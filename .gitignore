/logs/*
!/logs/records/
!/logs/records/README.md
!/logs/records/*.md

# Generated imaging/statistical products anywhere else
*.feat/
*.gfeat/
sub-*.html

# Generated EVs, physiological series, and rendered per-subject designs
run-*_*.txt
ts_task-*.txt
L1_sub-*.fsf
L2_sub-*.fsf
